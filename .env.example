# --- Required ---

# Your bot token from https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here

# The channel where the bot posts daily summaries & alerts
# Right-click channel → Copy ID (enable Developer Mode in Discord settings)
CHANNEL_ID=123456789012345678

# Your Discord user ID (only you can use /lte)
# Right-click your name → Copy ID
OWNER_ID=138372729660243968

# Your Discord server (guild) ID — makes /lte appear immediately after restart
# Right-click the server name in the channel list → Copy ID
GUILD_ID=123456789012345678

# --- Optional ---

# API URL for Telekom pass data
API_URL=https://pass.telekom.de/api/service/generic/v1/status

# Set to "true" to use built-in mock data, "false" to fetch from API_URL
MOCK_MODE=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
